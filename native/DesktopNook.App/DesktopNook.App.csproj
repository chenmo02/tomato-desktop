<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- UseWindowsForms 仅为 System.Windows.Forms.NotifyIcon（通知区图标与右键菜单），窗口本身仍是纯 WPF。 -->
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DesktopNook</AssemblyName><RootNamespace>DesktopNook.App</RootNamespace><Version>1.5.1</Version><Product>番茄桌面</Product>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\DesktopNook.Core\DesktopNook.Core.csproj" /><Resource Include="Assets\AppIcon.png" /><Resource Include="Assets\AppIcon.ico" /></ItemGroup>
  <!-- 关掉 WinForms 的两个隐式全局 using：否则 Application / Color 会与 WPF 同名类型冲突。
       托盘服务内部一律写全限定名。 -->
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
</Project>

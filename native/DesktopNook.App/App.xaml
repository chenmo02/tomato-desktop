<Application x:Class="DesktopNook.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopNook.App" Startup="OnStartup" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- WinUI 3 浅色系统色板：所有底色 Alpha=FF。窗口是 AllowsTransparency=True 的分层窗口，
         不透明底才能完全挡住背后应用窗口；壁纸只由 Glass.cs 提供极淡色调，不显示图案。 -->
    <SolidColorBrush x:Key="WinWindowFill" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="WinNavFill" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="WinCardFill" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="WinCardAlt" Color="#FFF9F9F9"/>
    <SolidColorBrush x:Key="WinStroke" Color="#FFE5E5E5"/>
    <SolidColorBrush x:Key="WinStrokeSoft" Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="WinText" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="WinTextSecondary" Color="#FF616161"/>
    <SolidColorBrush x:Key="WinTextTertiary" Color="#FF8A8A8E"/>
    <SolidColorBrush x:Key="WinAccent" Color="#FF0067C0"/>
    <SolidColorBrush x:Key="WinAccentHover" Color="#FF005A9E"/>
    <SolidColorBrush x:Key="WinAccentSoft" Color="#FFEFF6FF"/>
    <SolidColorBrush x:Key="WinAccentLine" Color="#FFCDE4FA"/>
    <SolidColorBrush x:Key="WinHover" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="WinUnderline" Color="#FF8A8A8E"/>
    <SolidColorBrush x:Key="WinClose" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="WinSyncGreen" Color="#FF107C10"/>
    <!-- 兼容键：弹窗样式与既有 C# 读取的旧资源名，统一映射到同一套系统色 -->
    <SolidColorBrush x:Key="GlassFill" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="GlassStroke" Color="#FFE5E5E5"/>
    <SolidColorBrush x:Key="GlassStrokeSoft" Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="GlassPanelStrong" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GlassMenu" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="GlassHover" Color="#FFE8E8E8"/>
    <!-- 皮肤专用键：两套皮肤下磁贴默认都完全透明，主按钮在玻璃皮肤下换成番茄红。
         WinTileHover / WinTilePressed 只提供极淡的悬停与按下反馈，不再铺成白色卡片；
         输入框聚焦底线单独用 WinFieldFocus，避免玻璃皮肤的番茄红被当成校验错误。
         保持 SolidColorBrush 类型，DialogPalette.Get 与自检都按此类型取值。 -->
    <SolidColorBrush x:Key="WinTileFill" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="WinTileHover" Color="#1F000000"/>
    <SolidColorBrush x:Key="WinTilePressed" Color="#33000000"/>
    <SolidColorBrush x:Key="WinFieldFocus" Color="#FF0067C0"/>
    <SolidColorBrush x:Key="WinPrimaryFill" Color="#FF0067C0"/>

    <!-- 系统字体：Segoe UI Variable 显示西文，Microsoft YaHei UI 显示中文，全部为本机自带。
         所有控件继承同一字体栈，不再使用 Segoe UI Symbol 等符号字体。 -->
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/></Style>
    <!-- WinUI 3 TextBox：白底、1px 中性描边、6px 圆角；占位文字取自 Tag。
         聚焦时描边转中性灰并浮出 2px 强调色下划线，绝不出现系统默认的蓝色焦点方框。 -->
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource WinText}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource WinText}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource WinAccent}"/>
      <Setter Property="Background" Value="{DynamicResource WinCardFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WinStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid>
          <!-- 底层：1px 中性描边；聚焦时边框不变深，让底线成为唯一焦点 -->
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
          <!-- 聚焦底线沿同一圆角轮廓绘制，两端自然收进圆角；不再是盖在框外的直角蓝条 -->
          <Border x:Name="AccentLine" BorderBrush="{DynamicResource WinFieldFocus}" BorderThickness="0,0,0,1.6" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
          <Grid>
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            <TextBlock x:Name="Placeholder" Text="{Binding Tag,RelativeSource={RelativeSource TemplatedParent}}" FontSize="{TemplateBinding FontSize}" Foreground="{DynamicResource WinTextTertiary}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WinUnderline}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WinStroke}"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="AccentLine" Storyboard.TargetProperty="Opacity" To=".9" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="AccentLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 全局滚动条：4px 细条、默认 25% 不透明度，鼠标移到滑块上才加深到 85%。
         WinUI 3 的覆盖式观感，避免粗灰条压在内容右侧。 -->
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Fill" Margin="0.5,2" Background="{DynamicResource WinUnderline}" CornerRadius="2" Opacity=".25"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value=".85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="4"/></Trigger></Style.Triggers></Style>
    <Style x:Key="WinMenuScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="4"/><Setter Property="MinWidth" Value="0"/>
      <Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
          <Border x:Name="Fill" Margin="0.5,2" Background="{DynamicResource WinUnderline}" CornerRadius="2" Opacity=".25"/>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value=".85"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
      </Track></Grid></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="4"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="WinMenuScrollViewer" TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Width="4" MinWidth="0" Margin="1,0,0,0" Orientation="Vertical" Style="{StaticResource WinMenuScrollBar}" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Height="4" MinHeight="0" Orientation="Horizontal" Style="{StaticResource WinMenuScrollBar}" Maximum="{TemplateBinding ScrollableWidth}" Value="{TemplateBinding HorizontalOffset}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MenuScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource WinMenuScrollViewer}"/>

    <!-- 系统线性图标：1.4px 描边、圆角端点，颜色继承按钮 Foreground，
         悬停关闭按钮时随按钮一起变白；不使用 Segoe UI Symbol 字形。 -->
    <Style x:Key="WinGlyphSearch" TargetType="ContentControl">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource WinTextSecondary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Width="14" Height="14">
        <Ellipse Width="9" Height="9" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
        <Line X1="9" Y1="9" X2="13.2" Y2="13.2" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- AutoSuggestBox：与上面同一套输入框规范，只是左侧多一枚放大镜；占位文字取自 Tag。 -->
    <Style x:Key="WinSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="12"/>
      <!-- Padding 置 0：WPF 会把它再传给内部 TextBoxView，若模板的 ScrollViewer 也绑定 Padding
           就会叠加两次，输入光标右移一个字宽、插进占位文字中间。内边距改由模板里的固定 Margin 统一给出。 -->
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Grid>
          <!-- 与通用 TextBox 同一套底线：按圆角轮廓收口，聚焦时柔和淡入 -->
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
          <Border x:Name="AccentLine" BorderBrush="{DynamicResource WinFieldFocus}" BorderThickness="0,0,0,1.6" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Style="{StaticResource WinGlyphSearch}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{Binding Tag,RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{DynamicResource WinTextTertiary}" Margin="8,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WinUnderline}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WinStroke}"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="AccentLine" Storyboard.TargetProperty="Opacity" To=".9" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="AccentLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 弹窗次要按钮：白底 1px 中性描边、6px 圆角，与蓝色主操作成对出现。 -->
    <Style x:Key="WinSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="80"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="Background" Value="{DynamicResource WinCardFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WinStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".85"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- WinUI ToggleSwitch：40×20 胶囊轨道。关闭为中性描边 + 左侧圆点，开启为强调色 + 白色圆点；
         圆点用 160ms 缓出平移，不出现系统默认的蓝色焦点方框。 -->
    <Style x:Key="WinToggleSwitch" TargetType="CheckBox">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="20"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Width="40" Height="20" Background="Transparent">
          <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" Background="Transparent"
                  BorderBrush="{DynamicResource WinUnderline}" BorderThickness="1.2"/>
          <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource WinUnderline}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
            <Ellipse.RenderTransform><TranslateTransform x:Name="KnobShift" X="0"/></Ellipse.RenderTransform>
          </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WinTextSecondary}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="{DynamicResource WinAccent}"/>
            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WinAccent}"/>
            <Setter TargetName="Knob" Property="Fill" Value="White"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- SettingsCard 行：统一 64px 行高、左右 20px 内边距，悬停浮出极淡底色。 -->
    <Style x:Key="WinSettingsRow" TargetType="Border">
      <Setter Property="MinHeight" Value="64"/><Setter Property="Padding" Value="20,10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource WinCardAlt}"/></Trigger>
      </Style.Triggers>
    </Style>

    <!-- 设置页下拉选择器：沿用次要按钮外观，内容左对齐并留出右侧箭头位置。 -->
    <Style x:Key="WinSettingsCombo" TargetType="Button" BasedOn="{StaticResource WinSecondaryButton}">
      <Setter Property="MinWidth" Value="128"/><Setter Property="Padding" Value="12,0,10,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".85"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinGlyphChevronDown" TargetType="ContentControl">
      <Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="Foreground" Value="{DynamicResource WinTextSecondary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Width="10" Height="10">
        <Path Data="M1.5,3.5 L5,7 L8.5,3.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}"
              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="WinGlyphGrid" TargetType="ContentControl">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Width="14" Height="14">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Rectangle Grid.Row="0" Grid.Column="0" Width="5.5" Height="5.5" RadiusX="1" RadiusY="1" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2"/>
        <Rectangle Grid.Row="0" Grid.Column="1" Width="5.5" Height="5.5" RadiusX="1" RadiusY="1" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2"/>
        <Rectangle Grid.Row="1" Grid.Column="0" Width="5.5" Height="5.5" RadiusX="1" RadiusY="1" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Width="5.5" Height="5.5" RadiusX="1" RadiusY="1" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2"/>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinGlyphPlus" TargetType="ContentControl">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Width="14" Height="14">
        <Line X1="2" Y1="7" X2="12" Y2="7" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line X1="7" Y1="2" X2="7" Y2="12" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinGlyphMore" TargetType="ContentControl">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,2.2,0"/>
        <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,2.2,0"/>
        <Ellipse Width="2.6" Height="2.6" Fill="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}"/>
      </StackPanel></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinGlyphMinimize" TargetType="ContentControl">
      <Setter Property="Width" Value="11"/><Setter Property="Height" Value="11"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Line X1="1" Y1="6" X2="10" Y2="6" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinGlyphMaximize" TargetType="ContentControl">
      <Setter Property="Width" Value="11"/><Setter Property="Height" Value="11"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Rectangle Width="8" Height="8" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinGlyphClose" TargetType="ContentControl">
      <Setter Property="Width" Value="11"/><Setter Property="Height" Value="11"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Width="11" Height="11">
        <Line X1="1.5" Y1="1.5" X2="9.5" Y2="9.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line X1="9.5" Y1="1.5" X2="1.5" Y2="9.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinGlyphBack" TargetType="ContentControl">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Width="14" Height="14">
        <Line X1="9" Y1="2" X2="4" Y2="7" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line X1="4" Y1="7" X2="9" Y2="12" Stroke="{Binding Foreground,RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinGlyphInfo" TargetType="ContentControl">
      <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Width="16" Height="16">
        <Ellipse Width="15" Height="15" Stroke="{DynamicResource WinAccent}" StrokeThickness="1.4"/>
        <Ellipse Width="1.8" Height="1.8" Fill="{DynamicResource WinAccent}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3.6,0,0"/>
        <Line X1="8" Y1="7" X2="8" Y2="11.5" Stroke="{DynamicResource WinAccent}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>

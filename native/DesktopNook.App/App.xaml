    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource GlassMenu}"/><Setter Property="Foreground" Value="{DynamicResource WinText}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource WinStroke}"/>
      <Setter Property="MinWidth" Value="204"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Margin="7" Padding="5,6" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
          <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity=".16" Color="#000000"/></Border.Effect>
          <ScrollViewer Style="{StaticResource WinMenuScrollViewer}" MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Separator"><Setter Property="Margin" Value="10,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="2,0" Background="{DynamicResource WinStroke}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="MenuItem">
      <Setter Property="Padding" Value="9,5"/><Setter Property="Foreground" Value="{DynamicResource WinText}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Grid>
        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" FontSize="10" Foreground="{DynamicResource WinAccent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <ContentPresenter x:Name="Icon" Grid.Column="1" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,4,0"/>
          <ContentPresenter x:Name="Header" Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
          <TextBlock x:Name="Gesture" Grid.Column="3" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource WinTextSecondary}" FontSize="10" Margin="14,0,4,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="Arrow" Grid.Column="4" Text="›" Visibility="Collapsed" Foreground="{DynamicResource WinTextSecondary}" HorizontalAlignment="Right"/>
        </Grid></Border>
        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}">
          <Border Padding="5,6" Margin="6" CornerRadius="8" Background="{DynamicResource GlassMenu}" BorderBrush="{DynamicResource WinStroke}" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="16" Opacity=".15" ShadowDepth="3" Color="#000000"/></Border.Effect>
            <ScrollViewer Style="{StaticResource WinMenuScrollViewer}" MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".38"/></Trigger>
        <DataTrigger Binding="{Binding InputGestureText, RelativeSource={RelativeSource TemplatedParent}}" Value=""><Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <Trigger Property="Tag" Value="GroupHeader">
          <Setter TargetName="Row" Property="Background" Value="Transparent"/>
          <Setter TargetName="Row" Property="Padding" Value="10,7,10,2"/>
          <Setter TargetName="Header" Property="Grid.Column" Value="0"/><Setter TargetName="Header" Property="Grid.ColumnSpan" Value="3"/>
          <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/><Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
          <Setter Property="Foreground" Value="{DynamicResource WinTextSecondary}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/>
        </Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource WinText}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 标准 caption 按钮：46×48 铺满标题栏高度，无边框，悬停中性灰；关闭悬停系统红 -->
    <Style x:Key="WinCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".7"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource WinCaptionButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinClose}"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".75"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- CommandBar：32px 方形图标按钮与蓝色主操作 -->
    <Style x:Key="WinCommandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource WinText}"/>
      <Setter Property="Background" Value="{DynamicResource WinCardFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WinStroke}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".85"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{DynamicResource WinPrimaryFill}"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource WinAccentHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource WinPrimaryButton}"/>
    <!-- NavigationView 行：36px 高、6px 圆角、3px 中性灰指示条、右侧项目计数。
         计数由 MainWindow 的附加属性 NavCount 提供，选中态由代码设置底色与 Uid。 -->
    <Style x:Key="WinNavRow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource WinText}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,1"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
         <Grid>
          <Border x:Name="Hover" Margin="-12,0" CornerRadius="6" Background="{DynamicResource WinHover}" Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource WinUnderline}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-9,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
          <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Path=(local:MainWindow.NavCount),RelativeSource={RelativeSource TemplatedParent}}" FontSize="11" Foreground="{DynamicResource WinTextTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
         </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Uid" Value="selected"><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarRow" TargetType="Button" BasedOn="{StaticResource WinNavRow}"/>
    <Style x:Key="WinBackButton" TargetType="Button" BasedOn="{StaticResource WinCommandButton}">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    </Style>
    <!-- 开始菜单式磁贴：图标在上、名称在下并水平居中；默认完全无底色、无描边、无右上更多符号，
         图标与名称直接落在窗口玻璃上。悬停/键盘焦点只浮出一层极淡的 8px 圆角底色，按下时略深；
         不使用白色卡片、蓝色框与投影。 -->
    <Style x:Key="WinTileCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource WinTileFill}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2,6"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Tile" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource WinTileHover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource WinTileHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource WinTilePressed}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- InfoBar 链接与关闭按钮 -->
    <Style x:Key="WinInfoLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource WinAccent}"/><Setter Property="Padding" Value="4,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WinInfoDismiss" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource WinTextSecondary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="Transparent" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- 「喂给番茄」弹窗专用样式：全部为带 Key 的显式样式，只由 CollectWindow 引用，不影响主窗口与其他对话框。 -->
    <Style x:Key="CollectScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="4"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border x:Name="Bar" Margin="0.5,2" Background="{DynamicResource WinUnderline}" CornerRadius="2"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource WinUnderline}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Opacity="0" Focusable="False" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="4"/></Trigger></Style.Triggers>
    </Style>
    <!-- 自绘 ScrollViewer 外壳：把滚动条的布局宽度也收到 4，避免系统模板把细滚动条撑宽 -->
    <Style x:Key="CollectScrollViewer" TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Width="4" MinWidth="0" Margin="1,0,0,0" Orientation="Vertical" Style="{StaticResource CollectScrollBar}" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Height="4" MinHeight="0" Orientation="Horizontal" Style="{StaticResource CollectScrollBar}" Maximum="{TemplateBinding ScrollableWidth}" Value="{TemplateBinding HorizontalOffset}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 显式指定下拉项的数据模板：DisplayMemberPath 的隐式模板在自绘 ComboBoxItem 模板里不会生效 -->
    <DataTemplate x:Key="CollectCategoryTemplate"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DataTemplate>
    <Style x:Key="CollectComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource WinText}"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource WinHover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource WinHover}"/><Setter Property="Foreground" Value="{DynamicResource WinText}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CollectCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource WinText}"/><Setter Property="Background" Value="{DynamicResource GlassPanelStrong}"/><Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeSoft}"/>
      <Setter Property="FontSize" Value="10.5"/><Setter Property="Height" Value="31"/><Setter Property="Padding" Value="10,5"/>
      <Setter Property="MaxDropDownHeight" Value="210"/><Setter Property="ItemContainerStyle" Value="{StaticResource CollectComboItem}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource WinTextSecondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" VerticalAlignment="Center" Margin="8,0,2,0"/>
            </Grid>
          </Border>
          <ToggleButton x:Name="Drop" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom" VerticalOffset="4" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="6" Padding="4" Background="{DynamicResource GlassMenu}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" CornerRadius="8">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity=".13" Color="#000000"/></Border.Effect>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WinUnderline}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WinUnderline}"/></Trigger>
          <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WinUnderline}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CollectCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource WinText}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Card" Background="{DynamicResource WinCardAlt}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="7,4" Margin="0,2">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
              <Border x:Name="Box" Background="{DynamicResource WinCardFill}" BorderBrush="{DynamicResource WinUnderline}" BorderThickness="1.4" CornerRadius="4.5"/>
              <TextBlock x:Name="Tick" Text="✓" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Grid.Column="1" ContentSource="Content" RecognizesAccessKey="True" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource GlassHover}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GlassHover}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Card" Property="Background" Value="{DynamicResource WinHover}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WinUnderline}"/>
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource WinAccent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WinAccent}"/>
            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WinUnderline}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CollectPrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource WinAccent}"/><Setter Property="FontSize" Value="10.5"/>

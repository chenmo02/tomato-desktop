<Window x:Class="DesktopNook.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DesktopNook.App" Title="番茄桌面" Width="1040" Height="680" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="False" Background="Transparent" Icon="Assets/AppIcon.png" ShowInTaskbar="True" Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei" FontSize="13" RenderOptions.BitmapScalingMode="HighQuality" AllowDrop="True" Loaded="OnLoaded" Deactivated="OnDeactivated" StateChanged="OnStateChanged" Closing="OnClosing" PreviewKeyDown="OnKeyDown" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
 <Grid><Viewbox Stretch="Uniform">
  <Border x:Name="Surface" Width="1040" Height="680" Background="{DynamicResource WinWindowFill}" BorderBrush="{DynamicResource WinStroke}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
   <Grid x:Name="GlassRoot">
    <!-- 圆角裁剪由 Glass.cs 跟随窗口尺寸更新；背景只铺一层 Alpha=FF 的不透明 Mica 底色 -->
    <Grid.Clip><RectangleGeometry x:Name="GlassClip" RadiusX="12" RadiusY="12"/></Grid.Clip>
    <!-- 底部状态栏已移除：第三行高度归零、元素折叠，内容区直接延伸到窗口底边。
         保留元素是为了让 SetStatus / Summary 等既有逻辑无需改动（约 30 处调用）。 -->
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <!-- 玻璃皮肤背景层：模糊壁纸 + 彩色光斑，由 Glass.cs 按壁纸路径与深浅主题重建。
         原生皮肤保持隐藏，窗口仍只铺一层不透明 Mica 底，视觉与交互完全不变。 -->
    <Grid x:Name="SkinBackdrop" Grid.RowSpan="3" IsHitTestVisible="False" Visibility="Collapsed"/>
    <Border Grid.RowSpan="3" Background="{DynamicResource WinWindowFill}" IsHitTestVisible="False"/>
    <!-- 标题栏：左侧品牌，右侧 46×48 标准 caption 按钮 -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource WinStrokeSoft}" BorderThickness="0,0,0,1">
     <Grid x:Name="TitleBar" Margin="16,0,0,0" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="按住此处可拖动面板；贴回任务栏请在“更多 → 窗口大小”中操作">
       <!-- 品牌图标使用应用自己的番茄图标；限制解码宽度，避免 1254px 原图占用大块内存 -->
       <Image Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Source><BitmapImage UriSource="Assets/AppIcon.png" DecodePixelWidth="36"/></Image.Source>
       </Image>
       <TextBlock Text="番茄桌面" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WinText}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right">
       <Button Style="{StaticResource WinCaptionButton}" AutomationProperties.Name="最小化番茄" ToolTip="最小化" Click="OnMinimizeButton"><ContentControl Style="{StaticResource WinGlyphMinimize}"/></Button>
       <Button Style="{StaticResource WinCaptionButton}" AutomationProperties.Name="窗口大小" ToolTip="窗口大小" Click="OnZoomButton"><ContentControl Style="{StaticResource WinGlyphMaximize}"/></Button>
       <Button Style="{StaticResource WinCaptionCloseButton}" AutomationProperties.Name="关闭番茄" ToolTip="关闭番茄" Click="OnCloseButton"><ContentControl Style="{StaticResource WinGlyphClose}"/></Button>
      </StackPanel>
     </Grid>
    </Border>
    <!-- 主体：236px NavigationView + 内容区 -->
    <Grid Grid.Row="1" x:Name="Workspace">
     <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="{DynamicResource WinNavFill}" BorderBrush="{DynamicResource WinStroke}" BorderThickness="0,0,1,0">
      <DockPanel>
       <!-- 侧栏 AutoSuggestBox：与全局输入框同一套 WinUI 规范，占位文字写在 Tag 里 -->
       <Border DockPanel.Dock="Top" Padding="14,14,14,0">
        <TextBox x:Name="CategorySearch" Height="32" Margin="4,0,4,12" Tag="查找分类" Style="{StaticResource WinSearchBox}" ToolTip="查找分类" TextChanged="OnCategorySearch"/>
       </Border>
       <!-- 侧栏底部：设置入口与版本 -->
       <Border DockPanel.Dock="Bottom" Padding="10,0,10,10" BorderBrush="{DynamicResource WinStroke}" BorderThickness="0,1,0,0">
        <StackPanel>
         <Button x:Name="SettingsNavButton" Content="设置" Style="{StaticResource WinNavRow}" ToolTip="打开设置" Click="OnSettingsToggle" Margin="0,10,0,0"/>
         <!-- 设计期占位；运行时由 MainWindow.ProductVersion 覆盖，始终跟随 csproj 的 <Version>。 -->
         <TextBlock x:Name="VersionLabel" Text="番茄桌面 · 版本 1.2" FontSize="10" Foreground="{DynamicResource WinTextTertiary}" Margin="12,8,0,0"/>
        </StackPanel>
       </Border>
       <ScrollViewer Style="{StaticResource WinMenuScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,2">
        <StackPanel x:Name="Tabs" Orientation="Vertical" Margin="10,0,10,8"/>
       </ScrollViewer>
      </DockPanel>
     </Border>
     <!-- 右侧内容区：大标题与 CommandBar 同一行，下方 InfoBar、分区标题与开始菜单式图标网格 -->
     <Grid Grid.Column="1" Background="{DynamicResource WinWindowFill}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel x:Name="ContentToolbar" Grid.Row="0" Margin="30,26,30,0">
       <!-- 页头：左侧 28px Light 大标题 + 副标题，右侧命令栏 -->
       <Grid Margin="0,0,0,18">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
         <TextBlock x:Name="CategoryTitle" Text="全部图标" FontSize="28" FontWeight="Light" Foreground="{DynamicResource WinText}"/>
         <TextBlock x:Name="PageSubtitle" Text="管理收纳到番茄桌面的项目，拖动可调整顺序" FontSize="12" Foreground="{DynamicResource WinTextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
         <!-- 内容区检索框 -->
         <TextBox x:Name="IconSearch" Width="176" Height="32" Margin="0,0,8,0" Tag="搜索图标" Style="{StaticResource WinSearchBox}" ToolTip="搜索图标（输入后按回车直接打开）" TextChanged="OnIconSearch" KeyDown="OnIconSearchKeyDown"/>
         <Button Style="{StaticResource WinCommandButton}" ToolTip="撤销上一步操作（Ctrl+Z）" Click="OnUndoButton" Margin="0,0,8,0"><ContentControl Style="{StaticResource WinGlyphBack}"/></Button>
         <Button Style="{StaticResource WinCommandButton}" AutomationProperties.Name="全部图标" AutomationProperties.AutomationId="Catalog" ToolTip="浏览全部图标：从开始菜单与系统应用里挑图标" Click="OnCatalogToggle" Margin="0,0,8,0"><ContentControl Style="{StaticResource WinGlyphGrid}"/></Button>
         <Button x:Name="CollectButton" Style="{StaticResource WinPrimaryButton}" AutomationProperties.AutomationId="Collect" Click="OnCollect" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WinGlyphPlus}" Margin="0,0,7,0"/><TextBlock Text="喂给番茄" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/></StackPanel>
         </Button>
         <Button Style="{StaticResource WinCommandButton}" AutomationProperties.Name="更多操作" ToolTip="更多操作" Click="OnMore"><ContentControl Style="{StaticResource WinGlyphMore}"/></Button>
        </StackPanel>
       </Grid>
       <!-- InfoBar：淡蓝底、蓝色信息图标、完整提示文案、了解更多链接与关闭 -->
       <Border x:Name="InfoBar" Background="{DynamicResource WinAccentSoft}" BorderBrush="{DynamicResource WinAccentLine}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ContentControl Grid.Column="0" Style="{StaticResource WinGlyphInfo}" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" x:Name="InfoText" Text="已收纳 12 个图标。拖到左侧分类行可直接归类，松手后自动吸附回网格。" FontSize="12" Foreground="{DynamicResource WinText}" VerticalAlignment="Center" Margin="11,0,8,0" TextWrapping="Wrap"/>
         <Button Grid.Column="2" Content="了解更多" Style="{StaticResource WinInfoLink}" Click="OnInfoMore" Margin="0,0,6,0"/>
         <Button Grid.Column="3" Content="×" Style="{StaticResource WinInfoDismiss}" Click="OnInfoDismiss"/>
        </Grid>
       </Border>
      <!-- 分组标题：左侧标题与数量，右侧一个「全部移除」按钮批量移回当前显示的图标。 -->
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" x:Name="SectionTitle" Text="已固定" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource WinText}" VerticalAlignment="Center"/>
       <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource WinCardFill}" BorderBrush="{DynamicResource WinStroke}" BorderThickness="1" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="CategoryBadge" Text="12 个" FontSize="11" Foreground="{DynamicResource WinTextSecondary}"/></Border>
       <Button Grid.Column="3" x:Name="RemoveAllButton" Content="全部移除" Style="{StaticResource WinSecondaryButton}" MinWidth="88" Height="28" Padding="10,4" Click="OnRemoveAll" IsEnabled="False" ToolTip="把当前显示的图标全部移回桌面（可先用分类或搜索筛选），可按 Ctrl+Z 撤销"/>
      </Grid>
      </StackPanel>
      <!-- 开始菜单式网格：图标在上、名称在下并居中，默认八列；
           列数由 WindowSizing 按内容区宽度计算，拖动只调整顺序。 -->
      <Grid Grid.Row="1" x:Name="DropSurface" Background="Transparent" Margin="30,0,30,0">
       <ScrollViewer Style="{StaticResource WinMenuScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Icons" VerticalAlignment="Top" Margin="0,0,0,6" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="收纳图标"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <Button Tag="{Binding Item}" Style="{StaticResource WinTileCard}" Height="104" Margin="1" Padding="2,6" ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding Id}" Click="OnIconClick" PreviewMouseLeftButtonDown="OnIconDown" PreviewMouseMove="OnIconMove" PreviewMouseLeftButtonUp="OnIconUp" MouseRightButtonUp="OnIconRightClick">
         <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="86" Opacity="{Binding IconOpacity}">
          <local:ShellIcon IconPath="{Binding Path}" IsRecycleBin="{Binding Recycle}" Width="44" Height="44" Margin="0,0,0,7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource WinText}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" HorizontalAlignment="Center"/>
         </StackPanel>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
       <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="EmptyText" Text="把桌面图标，喂给番茄" FontSize="13" Foreground="{DynamicResource WinTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,6"/><TextBlock Text="把桌面图标拖来喂番茄" FontSize="12" Foreground="{DynamicResource WinTextSecondary}" HorizontalAlignment="Center"/><Button Content="喂给番茄" FontSize="12" Click="OnCollect" Margin="0,18,0,0" Foreground="{DynamicResource WinAccent}" Background="{DynamicResource WinCardFill}"/></StackPanel>
      </Grid>
      <!-- 「全部图标」页面：从开始菜单 / 系统应用 / 桌面快捷方式挑进番茄桌面 -->
      <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="CatalogSurface" Margin="22,18,22,16" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Margin="8,0,8,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource WinBackButton}" AutomationProperties.Name="返回收纳页" ToolTip="返回收纳页" Click="OnCatalogToggle" Margin="0,0,12,0"><ContentControl Style="{StaticResource WinGlyphBack}"/></Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="全部图标" FontSize="24" FontWeight="Light" Foreground="{DynamicResource WinText}"/><TextBlock Text="从开始菜单与系统应用里挑图标，喂给番茄" FontSize="12" Foreground="{DynamicResource WinTextSecondary}" Margin="0,2,0,0"/></StackPanel>
        <TextBox Grid.Column="2" x:Name="CatalogSearch" Width="220" Height="32" VerticalAlignment="Center" Tag="搜索应用" Style="{StaticResource WinSearchBox}" ToolTip="搜索应用名称" TextChanged="OnCatalogSearch"/>
       </Grid>
       <Border Grid.Row="1" Background="{DynamicResource WinCardFill}" BorderBrush="{DynamicResource WinStroke}" BorderThickness="1" CornerRadius="10" Margin="0,0">
        <ScrollViewer x:Name="CatalogScroll" Style="{StaticResource WinMenuScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12,14,18" CanContentScroll="False" ScrollChanged="OnCatalogScrollChanged" SizeChanged="OnCatalogSizeChanged">
         <StackPanel x:Name="CatalogGroups" Orientation="Vertical"/>
        </ScrollViewer>
       </Border>
       <Border Grid.Row="2" BorderBrush="{DynamicResource WinStrokeSoft}" BorderThickness="0,1,0,0" Margin="8,12,8,0" Padding="0,10,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <!-- 「显示系统项目」已迁入「设置 → 行为」，底栏只保留选中计数与收纳操作。 -->
        <TextBlock Grid.Column="0" x:Name="CatalogCount" Text="已选 0 项" FontSize="12" Foreground="{DynamicResource WinTextSecondary}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" x:Name="CatalogCategory" Width="124" SelectedValuePath="Id" ItemTemplate="{StaticResource CollectCategoryTemplate}" Style="{StaticResource CollectCombo}" ToolTip="放入分类"/>
        <Button Grid.Column="2" x:Name="CatalogAccept" Content="喂给番茄" Margin="8,0,0,0" Click="OnCatalogAccept" IsEnabled="False">
         <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource WinPrimaryButton}">
           <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
             <Setter Property="Background" Value="{DynamicResource WinStrokeSoft}"/>
             <Setter Property="Foreground" Value="{DynamicResource WinTextSecondary}"/>
             <Setter Property="Opacity" Value="1"/>
            </Trigger>
           </Style.Triggers>
          </Style>
         </Button.Style>
        </Button>
        </Grid>
       </Border>
      </Grid>
      <!-- 设置页：与「全部图标」一样覆盖右侧内容区，分组卡片由 SettingsView 构建 -->
      <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="SettingsSurface" Margin="30,26,30,0" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Grid.Row="0" Margin="0,0,0,18">
        <TextBlock Text="设置" FontSize="28" FontWeight="Light" Foreground="{DynamicResource WinText}"/>
        <TextBlock Text="外观、行为、数据与本地备份" FontSize="12" Foreground="{DynamicResource WinTextSecondary}" Margin="0,4,0,0"/>
       </StackPanel>
       <ScrollViewer Grid.Row="1" Style="{StaticResource WinMenuScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,12,28">
        <StackPanel x:Name="SettingsGroups" Orientation="Vertical"/>
       </ScrollViewer>
      </Grid>
     </Grid>
    </Grid>
    <!-- 状态栏：左侧项目数，右侧绿色同步状态点。已折叠，视觉上完全移除。 -->
    <Border x:Name="StatusBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource WinWindowFill}" BorderBrush="{DynamicResource WinStrokeSoft}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" FontSize="11" Foreground="{DynamicResource WinTextSecondary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Ellipse Width="6" Height="6" Fill="{DynamicResource WinSyncGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="已同步 · 本地数据" FontSize="11" Foreground="{DynamicResource WinTextSecondary}" VerticalAlignment="Center" MaxWidth="250" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
   </Grid>
  </Border>
 </Viewbox><TextBlock x:Name="ResizeHint" Text="◢" FontSize="16" Foreground="{DynamicResource WinTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,5" IsHitTestVisible="False" Visibility="Collapsed"/><Grid x:Name="ResizeHandles" Visibility="Collapsed"/></Grid>
</Window>
